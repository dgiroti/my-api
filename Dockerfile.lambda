# ═══════════════ STAGE 1: BUILD (same as before) ═══════════════
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build


# ═══════════════ STAGE 2: LAMBDA RUNTIME ═══════════════
# AWS's official Node.js 22 image for Lambda.
# It already knows how to receive requests from Lambda and call your handler.
FROM public.ecr.aws/lambda/nodejs:22

# LAMBDA_TASK_ROOT is a built-in variable meaning /var/task,
# the folder where Lambda expects your code to live
COPY package*.json ${LAMBDA_TASK_ROOT}/
RUN npm ci --omit=dev

# Bring over only the compiled JavaScript from stage 1
COPY --from=builder /app/dist ${LAMBDA_TASK_ROOT}/dist

# Tell Lambda which function to call: the "handler" export in dist/lambda.js
CMD ["dist/lambda.handler"]